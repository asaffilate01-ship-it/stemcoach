# Browser-safe configuration only. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Production defaults: public launch, no development helpers.
VITE_PREVIEW_GATE_ENABLED=false
VITE_ENABLE_DEV_TOOLS=false

# Optional local preview/development values. VITE_ values are visible to the browser.
VITE_PREVIEW_ACCESS_CODE=
VITE_DEV_STUDENT_EMAIL=
VITE_DEV_STUDENT_PASSWORD=
VITE_DEV_TEACHER_EMAIL=
VITE_DEV_TEACHER_PASSWORD=
VITE_DEV_PARENT_EMAIL=
VITE_DEV_PARENT_PASSWORD=
VITE_DEV_ADMIN_EMAIL=
VITE_DEV_ADMIN_PASSWORD=

# Edge Function secrets are configured in Supabase, never exposed as VITE_ vars:
# APP_ORIGIN=https://your-production-domain.example
# STRIPE_SECRET_KEY=sk_live_...
# SUPABASE_SERVICE_ROLE_KEY=<managed by Supabase>
